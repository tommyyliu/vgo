/target/
# Run output. Old runs are under artifacts/old/, which keeps the Official and
# control runs apart so they can't pool into another Elo scale.
/artifacts
/.idea/
.venv
/.agents/
/.uv-cache/
Screenshot*.png
__pycache__/
*.py[cod]
.worktree/

# Client build inputs and outputs that are fetched or generated, not authored.
/client/node_modules
/client/vendor/
/client/public/model.onnx
/client/public/ort*.mjs
/client/public/ort*.wasm
# Built by client/build.js from vendor/ and src/.
/client/dist/

