/target/
/artifacts/
# The official-rules runs live in their own root, not a subdirectory of
# artifacts/. scripts/build-dense-curve.py globs `artifacts/*/records.jsonl` and
# fits one Bradley-Terry scale over everything it finds, so a run under a
# different ruleset sitting inside artifacts/ would be pooled into an Elo scale
# with models it has never played and could not play.
/artifacts-official/
/.idea/
.venv/
/.agents/
/.uv-cache/
Screenshot*.png
__pycache__/
*.py[cod]
.worktree/

# Client build inputs and outputs that are fetched or generated, not authored.
/client/node_modules/
/client/vendor/
/client/public/model.onnx
/client/public/ort*.mjs
/client/public/ort*.wasm
# Built by client/build.js from vendor/ and src/.
/client/dist/

# Sweep workspace: 1.4 GB of shards, arena records and checkpoints. Its own
# scripts live alongside them and are not tracked either, because they are
# scratch for one experiment rather than part of the pipeline.
/experiments/

# Rendered from ratings.json by scripts/build-dense-curve.py, which is tracked,
# so following diagnostics/.gitignore: only the scripts are.
/curve.html
/nohup.out
